# copy this file to .env and fill in the values
# on Vercel, add the same names under Project -> Settings -> Environment Variables

PORT=4000
MONGODB_URI=
JWT_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# optional, product list caching
REDIS_URL=

# chatbot
GROQ_API_KEY=
GEMINI_API_KEY=

# email for the login verification code (2FA) - login does not work without these
# gmail: SMTP_PASS must be a 16 character App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# optional, defaults to "Forever <SMTP_USER>"
SMTP_FROM=
# optional, defaults to true only for port 465
SMTP_SECURE=
