# copy this file to .env and fill in the values
# on Render, add the same names under your service -> Environment

PORT=4000
MONGODB_URI=
JWT_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# optional, product list caching
REDIS_URL=

# chatbot
GROQ_API_KEY=
GEMINI_API_KEY=

# email for the login verification code (2FA) - login does not work without these
# option 1 (use this on Render's free plan, which blocks SMTP): Brevo email API
BREVO_API_KEY=
# must be a sender address you verified in Brevo, e.g. Forever <you@gmail.com>
EMAIL_FROM=

# option 2 (local / paid hosting): SMTP, e.g. gmail with a 16 character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# optional, defaults to "Forever <SMTP_USER>"
SMTP_FROM=
# optional, defaults to true only for port 465
SMTP_SECURE=
